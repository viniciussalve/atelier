{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // `src/lib/db.ts` imports scripts/migration-plan.mjs; checkJs types the
    // implementation itself instead of a hand-written declaration beside it.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    // The server reads bundled catalogs (src/lib/ai/data, @iconify/collections).
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "server"
  ],
  // Platform glue that no route imports and whose sibling modules (auth
  // client/server, connector client, p2p) are not part of this repository.
  "exclude": [
    "src/lib/multiplayer",
    "src/lib/auth/use-current-user.ts",
    "src/lib/auth/middleware.ts",
    "src/lib/auth/verify.server.ts",
    "src/lib/app-data/index.ts",
    "src/lib/app-data/readiness.ts",
    "src/lib/app-data/use-connector-readiness.ts"
  ]
}
